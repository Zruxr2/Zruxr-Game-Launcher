{
  "name": "zruxr",
  "productName": "Zruxr",
  "version": "1.2.0",
  "description": "Zruxr - a simple launcher for your own game files.",
  "author": "Zruxr",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "homepage": "https://github.com/OWNER/REPO#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/REPO.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/REPO/issues"
  },
  "keywords": [
    "game-launcher",
    "electron",
    "windows",
    "library",
    "playtime-tracker"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:setup": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.zruxr.launcher",
    "productName": "Zruxr",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "cloud.js",
      "scanner.js",
      "discover.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Zruxr-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Zruxr-Portable-${version}.${ext}"
    }
  }
}
